# Runtime identity
APP_ENVIRONMENT=local
RELEASE_VERSION=local
GIT_SHA=unknown
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Local/test identity only. This mechanism is hard-disabled in dev/staging/production.
ALLOW_LOCAL_IDENTITY=true
LOCAL_IDENTITY_SUBJECT=00000000-0000-4000-8000-000000000001
LOCAL_IDENTITY_USERNAME=local-owner
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Local persistence
STORAGE_BACKEND=sqlite
SQLITE_PATH=.local/aws-friendly-counsellor.db

# AWS deployments use API Gateway + Cognito and inject DynamoDB configuration through SAM.
# STORAGE_BACKEND=dynamodb
# DYNAMODB_TABLE_NAME=generated-by-cloudformation
# AWS_REGION=eu-central-1
